<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/pca_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/pca_navy"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnHomeStaffDashboard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/pca_gold"
        android:textColor="@color/pca_navy"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:text="@string/staff_dashboard"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_intro"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/btnReportComplaint"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/pca_navy"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:text="@string/report_a_complaint" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/home_draft_guidance"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAiAssist"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/pca_gold"
        android:textColor="@color/pca_navy"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:text="@string/need_help_describing" />

    <Button android:id="@+id/btnMyComplaints" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/home_my_complaints"
        android:layout_marginTop="18dp" />
    <Button android:id="@+id/btnLearn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/nav_learn"
        android:layout_marginTop="4dp" />

</LinearLayout>
</ScrollView>
