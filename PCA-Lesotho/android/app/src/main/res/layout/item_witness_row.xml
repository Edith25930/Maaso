<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp">

    <EditText style="@style/Widget.Pca.FormField" android:id="@+id/inputWitnessName"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:hint="@string/form_witness_name" />
    <EditText style="@style/Widget.Pca.FormField" android:id="@+id/inputWitnessContact"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:hint="@string/form_contact_number"
        android:inputType="phone" android:layout_marginStart="8dp" />
    <ImageButton android:id="@+id/btnRemoveWitness" android:layout_width="40dp" android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@android:color/transparent"
        android:contentDescription="@string/form_remove" />

</LinearLayout>
