<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/form_supporting_evidence" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/form_attach_evidence" android:textColor="@color/text_secondary" android:layout_marginBottom="4dp" />

    <TextView android:id="@+id/textEvidenceSize" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnTakePhoto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/form_take_photo" />
        <Button android:id="@+id/btnChoosePhoto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/form_choose_photo" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnChooseVideo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/form_choose_video" />
        <Button android:id="@+id/btnChooseDocument" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/form_choose_document" />
    </LinearLayout>
    <Button android:id="@+id/btnRecordAudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/form_record_audio" android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEvidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/form_evidence_safety_note"
        android:textColor="@color/status_red" android:textSize="12sp" android:layout_marginTop="8dp" />

</LinearLayout>
</ScrollView>
