<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/pca_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/profile_title"
                android:textColor="@color/pca_navy"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/textProfileName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="16dp" android:textColor="@color/pca_navy" />
        <TextView android:id="@+id/textProfilePhone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/profile_shortcuts" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginTop="28dp" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnProfileComplaints" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/home_my_complaints"
            android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnProfileNotifications" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/nav_notifications"
            android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnProfileLearn" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/learn_about_pca" />
        <Button android:id="@+id/btnProfileStaffDashboard" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/staff_dashboard"
            android:visibility="gone" />
        <Button android:id="@+id/btnProfileVerifyEmail" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/resend_verification_email"
            android:visibility="gone" />
        <Button android:id="@+id/btnProfileGettingStarted" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/getting_started" />
        <Button android:id="@+id/btnProfileToggleLanguage" style="@style/Widget.Pca.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/switch_to_sesotho" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:text="@string/sign_out" />
    </LinearLayout>
</ScrollView>
